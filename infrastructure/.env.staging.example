# Copiar a infrastructure/.env.staging y completar con valores reales.
# NUNCA commitear el archivo real (.env.staging esta en .gitignore).
# Placeholder — staging todavia no tiene servidor real (ver
# docs/02-arquitectura-y-db/Plan_Fase4_Infraestructura.md).

# POSTGRES_USER es el owner/superusuario (solo para migraciones a mano) — NO
# puede ser `app_user`, ver el comentario largo en .env.production.example.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTO
POSTGRES_DB=volumetrix

# Password del rol `app_user` (no-superusuario, RLS-safe) — DEBE coincidir con
# la password embebida en DATABASE_URL de abajo.
APP_USER_PASSWORD=CAMBIAR_ESTO

NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://app_user:CAMBIAR_ESTO@postgres:5432/volumetrix
DB_POOL_MAX=10

REDIS_HOST=redis
REDIS_PORT=6379

APP_DOMAIN=staging.volumetrixpa.com
WEB_URL=https://staging.volumetrixpa.com

# Secretos DISTINTOS a los de produccion — nunca reutilizar.
JWT_SECRET=CAMBIAR_ESTO
APP_SECRET=CAMBIAR_ESTO
MFA_SECRET_KEY=CAMBIAR_ESTO

EVOLUTION_API_KEY=CAMBIAR_ESTO
