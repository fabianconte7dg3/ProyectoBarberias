# Copiar a infrastructure/.env.production y completar con valores reales.
# NUNCA commitear el archivo real (.env.production esta en .gitignore).

# --- Postgres ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CAMBIAR_ESTO
POSTGRES_DB=volumetrix

# --- apps/api ---
NODE_ENV=production
PORT=4000

# Via PgBouncer (pool_mode=transaction) — verificar antes de usar este default
# que la suite de integration tests real sigue en verde contra el puerto 6432
# (ver docs/02-arquitectura-y-db/Plan_Fase4_Infraestructura.md, seccion
# PgBouncer). Si todavia no se corrio esa verificacion, apuntar directo a
# postgres:5432 en su lugar.
DATABASE_URL=postgresql://app_user:CAMBIAR_ESTO@pgbouncer:6432/volumetrix

DB_POOL_MAX=10

REDIS_HOST=redis
REDIS_PORT=6379

# Dominio publico de la app (usado para construir links/emails) y del portal
# web (CORS, redirects) — ver PROD_ORIGIN_REGEX en apps/api/src/main.ts.
APP_DOMAIN=volumetrixpa.com
WEB_URL=https://volumetrixpa.com

# Secretos — generar valores unicos y largos (ej. `openssl rand -hex 32`),
# nunca reutilizar los de dev/staging.
JWT_SECRET=CAMBIAR_ESTO
APP_SECRET=CAMBIAR_ESTO
MFA_SECRET_KEY=CAMBIAR_ESTO

# WhatsApp (Evolution API) — ver docs/03-integraciones/WhatsApp_Evolution_API.md
EVOLUTION_API_KEY=CAMBIAR_ESTO
