# Caddyfile de produccion — Volumetrix, dominio parametrizado via APP_DOMAIN
# ({$APP_DOMAIN}, ver .env.production y docker-compose.production.yml).
#
# TLS: on-demand por subdominio (cada host emite su propio certificado
# individual la primera vez que se ve, via HTTP-01), NO certificado
# wildcard. Un wildcard real (*.{$APP_DOMAIN}) requeriria DNS-01
# challenge con credenciales de API de un proveedor DNS (Cloudflare,
# Route53, etc.) que todavia no se ha elegido — queda documentado como
# optimizacion posterior, no implementado aqui. On-demand TLS solo
# necesita el registro DNS wildcard "*.{$APP_DOMAIN} -> IP del
# servidor" apuntado por el usuario, sin API keys de terceros.
{
	# Sin `ask`, on-demand TLS emitiria un certificado para CUALQUIER hostname
	# que alguien apunte a la IP del servidor (abuso / agotamiento de rate
	# limits de Let's Encrypt). Caddy llama a esta URL con ?domain=<host> antes
	# de cada emision y solo procede si responde 200 — ver
	# TenantsController.validarDominio / TenantsService.validarDominioParaTls.
	on_demand_tls {
		ask http://api:4000/tenants/validar-dominio
	}
}

# Dominio raiz + www: landing (app/page.tsx) y panel de super-admin
# (app/super-admin/**), ambos servidos por el contenedor `web` tal cual
# — proxy.ts no reescribe nada para estos hosts (ver RESERVED_SUBDOMAINS
# y ROOT_HOSTS en apps/web/src/proxy.ts).
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	reverse_proxy web:3000
}

# Backend NestJS — el navegador llama directo a este host
# (NEXT_PUBLIC_API_URL, ver apps/web/src/lib/api.ts), no hay proxy interno
# de Next.js de por medio.
api.{$APP_DOMAIN} {
	reverse_proxy api:4000
}

# Un subdominio por tenant (barberia-jose.{$APP_DOMAIN}, ...). proxy.ts
# en el contenedor `web` reescribe internamente a /[tenantSlug]/... segun
# el primer label del Host — Caddy no necesita saber nada de tenants,
# solo enrutar cualquier host no reservado al mismo contenedor `web`.
*.{$APP_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy web:3000
}
